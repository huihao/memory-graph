# Backend environment variables
# Copy this file to .env and fill in your values

# OpenAI API Key (optional - for enhanced article analysis)
# If not provided, the system will use simple keyword-based analysis
OPENAI_API_KEY=

# Database URL (default: SQLite in current directory)
# SQLALCHEMY_DATABASE_URL=sqlite:///./memory_graph.db

# API Configuration
# API_HOST=0.0.0.0
# API_PORT=8000
