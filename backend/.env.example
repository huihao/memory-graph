# Backend environment variables
# Copy this file to .env and fill in your values

# OpenAI API Key (optional - for enhanced article analysis)
# If not provided, the system will use simple keyword-based analysis
OPENAI_API_KEY=

# Database URL (default: SQLite in current directory)
# SQLALCHEMY_DATABASE_URL=sqlite:///./memory_graph.db

# API Configuration
# API_HOST=0.0.0.0
# API_PORT=8000

# Neo4j Integration
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password

# Notion Integration
# NOTION_API_KEY=your_notion_token
# NOTION_INBOX_DB_ID=your_database_id

# Obsidian Integration
# OBSIDIAN_VAULT_PATH=/path/to/obsidian/vault
